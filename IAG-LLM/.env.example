# Ollama (LLM)
IAC_OLLAMA_MODEL=llama3.1
IAC_LLM_TIMEOUT_S=180
IAC_OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m

# Ollama (embeddings)
# Nota: modelos de chat (ex.: llama3.1) normalmente NÃO suportam embeddings.
# Recomendado: nomic-embed-text ou mxbai-embed-large.
IAC_OLLAMA_EMBED_MODEL=nomic-embed-text

# Ingestão por URL (segurança e limites)
IAC_FETCH_TIMEOUT_S=20
IAC_FETCH_MAX_BYTES=5000000
IAC_FETCH_MAX_REDIRECTS=3

# Chunking (aproximação por palavras)
IAC_CHUNK_SIZE_WORDS=800
IAC_CHUNK_OVERLAP_WORDS=120

# Django (dev)
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=change-me
